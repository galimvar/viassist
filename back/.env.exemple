DB_HOST=localhost
DB_PORT=port Base de données
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_NAME=NAME

PORT=numero_de_port_3000_par_exemple
JWT_SECRET=remplacer_par_la_cle_generee
# Clé secrète qui signe les jetons de connexion (JWT). À garder secrète, propre à chaque environnement.
# Pour en générer une, lancer dans un terminal :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# puis coller le résultat ci-dessous dans votre .env (jamais dans ce fichier).

PORT=port du serveur API (3000, attendu par le proxy du front)

