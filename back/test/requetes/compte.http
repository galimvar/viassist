@baseUrl = http://localhost:3000/api

# ==========================================================================
#  compte.http — lire et modifier SON compte
#  ⚠️ Lancer les requêtes DANS L'ORDRE : REST Client mémorise le cookie
#     de connexion et l'envoie automatiquement aux requêtes suivantes.
# ==========================================================================


# ---------------------------------------------------------------- SANS CONNEXION

### 0. Déconnexion (repartir d'un état propre) → 204
POST {{baseUrl}}/auth/deconnexion

### 1. Modifier sans être connecté → 401 (le middleware auth bloque avant le controller)
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophie",
    "mail": "sophie.martin@example.com",
    "date_naissance": "1968/09/02"
}


# ---------------------------------------------------------------- CONNEXION

### 2. Connexion de Sophie → 200 + cookie mémorisé
POST {{baseUrl}}/auth/connexion
Content-Type: application/json

{
    "mail": "sophie.martin@example.com",
    "mot_de_passe": "Motdepasse1!"
}

### 3. Lire mon compte → 200 avec id, nom, prénom, date, mail, téléphone, rôle (jamais le hash)
GET {{baseUrl}}/auth/moi


# ---------------------------------------------------------------- MODIFICATIONS OK

### 4. Modifier prénom + date + ajouter un téléphone → 200, « Sophia », 1968-09-03, « 0612345678 » (nettoyé)
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophia",
    "mail": "sophie.martin@example.com",
    "date_naissance": "1968/09/03",
    "telephone": "06 12 34 56 78"
}

### 5. Restaurer prénom + date SANS envoyer le téléphone → 200, telephone toujours « 0612345678 » (COALESCE)
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophie",
    "mail": "sophie.martin@example.com",
    "date_naissance": "1968/09/02"
}


# ---------------------------------------------------------------- ERREURS DU CONTROLLER (422)

### 6. Toutes les erreurs de forme d'un coup → 422 avec 5 clés dans erreurs :
###    prenom, mail, telephone, ancien_mot_de_passe, nouveau_mot_de_passe
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "",
    "mail": "sophie-sans-arobase",
    "date_naissance": "1968/09/02",
    "telephone": "banane",
    "nouveau_mot_de_passe": "court",
    "confirmation_mot_de_passe": "court"
}


# ---------------------------------------------------------------- ERREURS DU SERVICE (une par requête : le service s'arrête au premier throw)

### 7. Confirmation différente → 400 « Le mot de passe n'est pas identique »
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophie",
    "mail": "sophie.martin@example.com",
    "date_naissance": "1968/09/02",
    "ancien_mot_de_passe": "Motdepasse1!",
    "nouveau_mot_de_passe": "NouveauMdp2!",
    "confirmation_mot_de_passe": "AutreChose3!"
}

### 8. Ancien mot de passe faux → 400 « Ancien mot de passe incorrect »
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophie",
    "mail": "sophie.martin@example.com",
    "date_naissance": "1968/09/02",
    "ancien_mot_de_passe": "PasLeBon999!",
    "nouveau_mot_de_passe": "NouveauMdp2!",
    "confirmation_mot_de_passe": "NouveauMdp2!"
}

### 9. Mail déjà utilisé (celui de Laurent) → 409 « Un compte existe déjà avec cet email »
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophie",
    "mail": "laurent.delacroix@example.com",
    "date_naissance": "1968/09/02"
}


# ---------------------------------------------------------------- CHANGEMENT DE MOT DE PASSE

### 10. Changement correct → 200
PATCH {{baseUrl}}/personne/modifierMoi
Content-Type: application/json

{
    "nom": "Martin",
    "prenom": "Sophie",
    "mail": "sophie.martin@example.com",
    "date_naissance": "1968/09/02",
    "ancien_mot_de_passe": "Motdepasse1!",
    "nouveau_mot_de_passe": "NouveauMdp2!",
    "confirmation_mot_de_passe": "NouveauMdp2!"
}

### 11. Reconnexion avec le NOUVEAU mot de passe → 200 (preuve que le 10 a marché)
POST {{baseUrl}}/auth/connexion
Content-Type: application/json

{
    "mail": "sophie.martin@example.com",
    "mot_de_passe": "NouveauMdp2!"
}

