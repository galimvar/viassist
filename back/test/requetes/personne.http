@baseUrl = http://localhost:3000/api/personne
### GET affiche une personne (200)
GET {{baseUrl}}/1
Content-Type: application/json

{
    "id": 1,
    "nom": "Lemaire",
    "prenom": "Odette",
    "date_naissance": "1941-03-14",
    "mail": "odette.lemaire@example.com",
    "role": "bénéficiaire"
}

### POST renvoie 201
POST {{baseUrl}}/inscription
Content-Type: application/json

{
    "nom":"Lagarre",
    "prenom":"Rémy",
    "mail":"remy.lagarre@gmail.com",
    "date_naissance":"1989/04/10",
    "role":"admin",
    "mot_de_passe":"Prout!1234"
}